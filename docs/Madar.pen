        {
          "type": "text",
          "id": "a6N9uj",
          "name": "Navigation",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Navigation",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "K81rI4",
          "name": "Navigation description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Mobile: Home · Sales · Stock · More + New\nDesktop: Home · Sales · Purchases · Inventory · Contacts · Money · Projects · Settings\nItems & Services sits in Inventory; service businesses use Catalog in place of Stock.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "hZkUt",
          "name": "Six connected flows",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Six connected flows",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "lv6bp",
          "name": "Six connected flows description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Quick sale: customer → products/services → review & payment → confirm → receipt\nPurchase: supplier → order → partial receipt → supplier invoice → payment\nCollection: customer → invoices → amount & allocation → account → confirm\nTransfer: source/destination → quantities → review → confirm\nProject: requirements → supply stock / buy shortfall → site delivery → consume / return\nExpense: category → amount/date/account → project & receipt → review → save",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "d4ae5x",
          "name": "Business isolation",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Business isolation",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "n7HkN",
          "name": "Business isolation description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Each connection is one company in one ERPNext installation. All records, drafts, searches, balances, and notifications belong to the active business. Never combine balances or carry baskets between businesses.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "G9LpEX",
          "name": "Roles & release boundary",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Roles & release boundary",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "C4yXXi",
          "name": "Roles & release boundary description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Owner sees permitted work across modules. Salesperson sees Sales, Contacts, Catalog and collections. Warehouse staff see Stock, deliveries and project supply. Hide unavailable destinations; keep a useful Home and New action. No HR, payroll, production, bookings or advanced accounting.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "r6VxH",
          "name": "Build inventory",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Build inventory",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "tTDzT",
          "name": "Build inventory description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Foundations & component library → connection/sign-in/switcher → Home roles → catalog & item/service → complete quick sale → Arabic Home & sale → purchasing, contacts, inventory, money & projects.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
