              "fontFamily": "$md-font",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "g0Yfx",
              "name": "Guidance",
              "fill": "$md-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Dialog: accessible name, modal role, initial focus on title or safe action, trapped focus, Escape cancels, focus returns to opener. Status and draft feedback use polite live regions; blocking errors use an alert. Do not announce decorative icons.",
              "lineHeight": 1.4,
              "fontFamily": "$md-font",
              "fontSize": 16,
              "fontWeight": "normal"
