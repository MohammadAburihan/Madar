              "fill": "$md-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use lang=ar and dir=rtl; Inter for English, Noto Sans Arabic for Arabic. Reverse navigation, tables, alignment and directional arrows; never mirror logos or nondirectional icons. Western digits 0–9 in both locales; ILS and record codes remain literal. Isolate codes, amounts, dates, emails, URLs and phones as LTR runs. Dates use dd/MM/yyyy with an explicit locale label.",
              "lineHeight": 1.4,
              "fontFamily": "$md-font",
              "fontSize": 16,
