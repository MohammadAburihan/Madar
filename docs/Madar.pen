          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "eA8mx",
          "name": "Layout & access description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "8 px spacing scale • 48 px touch controls • visible 2 px focus ring • status text with color • restrained borders, 8–12 px corners • no decorative dashboard charts.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "HDWnO",
          "name": "Responsive rules",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Responsive rules",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "VQTqv",
          "name": "Responsive rules description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "390 px mobile reference. At 320–389 px, wrap names and stack fields. 768–1199 px: collapsible navigation and stacked task panels. At 1200+ px, sidebar and searchable split views. Never stretch a mobile layout across desktop.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "JciPc",
          "name": "Arabic & amounts",
          "fill": "$md-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Arabic & amounts",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "T9oss",
          "name": "Arabic & amounts description",
          "fill": "$md-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Mirror navigation, columns and task progression in RTL. Keep Latin item codes and numbers isolated in LTR text runs. Allow long names to wrap. Currency belongs to the active business; ILS is sample data, not a global token.",
          "lineHeight": 1.4,
          "fontFamily": "$md-font",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
